construct_comprehensive_df <- function(flux, enrichment_df,  conditions, subsystem=rxn_df){
df <- flux %>%
filter(experiment %in% conditions) %>%
group_by(experiment) %>%
summarise(across(where(is.numeric), mean)) %>%
tidyr::pivot_longer(cols = !experiment, values_to = "mean", names_to = "Reaction") %>%
tidyr::pivot_wider(names_from = experiment, id_cols = Reaction, values_from= mean)
enrichment_df <- left_join(enrichment_df, df, by = "Reaction")
final_df <- left_join(enrichment_df, subsystem, by="Reaction")
return(final_df)
}
