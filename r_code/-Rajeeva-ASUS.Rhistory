plot_flux_dist <- function(data, reaction) {
p <- data %>%
ggplot(aes(x=.data[[reaction]], fill=experiment)) +
geom_histogram(alpha=0.5, bins=50) +
guide_legend(title='Condition')
return(p)
}
plot_flux_dist(df, disp_high[1])
plot_flux_dist <- function(data, reaction) {
p <- data %>%
ggplot(aes(x=.data[[reaction]], fill=experiment)) +
geom_histogram(alpha=0.5, bins=50) +
labs(y='Count', fill='Condition')
return(p)
}
