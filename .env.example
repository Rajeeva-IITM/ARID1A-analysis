# Path to your local COBRA Toolbox installation (required for MATLAB scripts)
# Download from: https://opencobra.github.io/cobratoolbox/
COBRATOOLBOX_PATH="/path/to/cobratoolbox/"

# Path to data directory (default: ./data)
DATA_PATH="./data"

# Path to conda environment (default: ../conda_env)
CONDA_ENV="../conda_env"

# Path to Gurobi license file (required for MATLAB solver)
# Gurobi is a commercial solver — obtain a free academic license at:
# https://www.gurobi.com/academia/academic-program-and-licenses/
GUROBI_LICENSE="/path/to/gurobi.lic"
